{
	"name": "@empyria/restate-llm",
	"version": "0.1.9",
	"description": "Restate.dev helpers for LLM manipulation",
	"license": "MIT",
	"author": "Imre Fazekas <imre.fazekas@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/empyria-nano/restate-llm.git"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./lib/*": "./lib/*.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "bun oxfmt --check",
		"format:fix": "bun oxfmt",
		"lint": "bun oxlint",
		"lint:fix": "bun oxlint --fix",
		"test": "bun test --coverage",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@ag-ui/encoder": "0.0.59",
		"@ai-sdk/openai-compatible": "3.0.49",
		"@ai-sdk/provider": "4.0.15",
		"@empyria/restate": "0.1.17",
		"@restatedev/restate-sdk": "^1.17.0",
		"ai": "7.0.102"
	},
	"devDependencies": {
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0"
	},
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=26"
	},
	"packageManager": "bun@1.4.2"
}
